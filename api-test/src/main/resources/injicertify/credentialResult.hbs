{
    "credentials": [
        {
            "credential":
{{#if proofType}}
            {
                "proof": {
                    "type": "{{proofType}}",
{{#if cryptoSuite}}
                    "cryptosuite": "{{cryptoSuite}}",
{{/if}}
                    "proofPurpose": "{{proofPurpose}}"
                }
{{#if statusPurpose}},
                "credentialStatus": {
                    "type": "BitstringStatusListEntry",
                    "statusPurpose": "{{statusPurpose}}"
                }
{{/if}}
            }
{{else}}
            "{{{credentialPattern}}}"
{{/if}}
        }
    ]
}
