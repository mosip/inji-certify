{
	"vcTemplate": {
  "nameSpaces": {
    {{#each nameSpaces}}
    "{{namespace}}": [
      {{#each elements}}
      {
        "digestID": {{digestID}},
        "elementIdentifier": "{{elementIdentifier}}",
        "elementValue": {{#if isString}}"{{elementValue}}"{{else}}"RAW:{{elementValue}}"{{/if}}
      }{{#unless @last}},{{/unless}}
      {{/each}}
    ]{{#unless @last}},{{/unless}}
    {{/each}}
  },
  "validityInfo": {
    "validFrom": "${_validFrom}",
    "validUntil": "${_validUntil}"
  }
},
    "contextURLs": [
	      {{#each contextURLs}}
	            "{{contextURLs}}"
	          {{#unless @last}},{{/unless}}
	      	{{/each}}
        ],
	"credentialTypes": [
	      {{#each credentialTypes}}
	            "{{credentialTypes}}"
	          {{#unless @last}},{{/unless}}
	      	{{/each}}
        ],       	
    "credentialFormat": "{{credentialFormat}}",
    "credentialConfigKeyId": "{{credentialConfigKeyId}}",    
    "didUrl": "{{didUrl}}",        
    "keyManagerAppId" : "{{keyManagerAppId}}",
    "keyManagerRefId" : "{{keyManagerRefId}}",
    {{#if signatureAlgo}}
    "signatureAlgo" : "{{signatureAlgo}}",
    {{/if}}
    {{#if signatureCryptoSuite}}
    "signatureCryptoSuite" : "{{signatureCryptoSuite}}",
    {{/if}}
    {{#if cryptographicBindingMethodsSupported}}
    "cryptographicBindingMethodsSupported": [{{#each cryptographicBindingMethodsSupported}}"{{this}}"{{#unless @last}},{{/unless}}{{/each}}],
    {{/if}}
    {{#if proofTypeName}}
    "proofTypesSupported": {"{{proofTypeName}}": {"proof_signing_alg_values_supported": [{{#each proofSigningAlgValuesSupported}}"{{this}}"{{#unless @last}},{{/unless}}{{/each}}]}},
    {{/if}}
    "sdClaim" : "{{sdClaim}}",
    "displayOrder" : [
	      {{#each displayOrder}}
	            "{{displayOrder_values}}"
	          {{#unless @last}},{{/unless}}
	      	{{/each}}
        ],
    "scope" : "{{scope}}",
    "metaDataDisplay" : [{
    "name": "{{display_name}}",
    "locale": "en",
    "logo": {
      "uri": "https://mosip.github.io/inji-config/logos/agro-vertias-logo.png",
      "alt_text": "land statement Logo"
    },
    "background_color": "#ebfaff",
    "background_image": {"uri": "https://mosip.github.io/inji-config/logos/agro-vertias-logo.png"},
    "text_color": "#000000"
  }],
    "msoMdocClaims" : {
    {{#each msoMdocClaims}}
    "{{namespace}}": {
      {{#each claims}}
      "{{claim_name}}": {
        "display": [
          {{#each display}}
          {
            "name": "{{display_name}}",
            "locale": "{{display_locale}}"
          }{{#unless @last}}, {{/unless}}
          {{/each}}
        ]
      }{{#unless @last}}, {{/unless}}
      {{/each}}
    }{{#unless @last}}, {{/unless}}
    {{/each}}
  }
}