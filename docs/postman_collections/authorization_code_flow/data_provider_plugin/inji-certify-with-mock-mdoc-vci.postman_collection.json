						"method": "POST",
						"header": [],
						"body": {
							"mode": "raw",
							"raw": "{\r\n  \"vcTemplate\": \"\",\r\n  \"credentialConfigKeyId\": \"DrivingLicenseCredential\",\r\n  \"contextURLs\": [],\r\n  \"credentialTypes\": [],\r\n  \"credentialFormat\": \"mso_mdoc\",\r\n  \"didUrl\": \"did:web:inji.github.io:inji-config:dev-int-inji:mock-mdl\",\r\n  \"keyManagerAppId\": \"CERTIFY_VC_SIGN_EC_R1\",\r\n  \"keyManagerRefId\": \"EC_SECP256R1_SIGN\",\r\n  \"signatureAlgo\": \"ES256\",\r\n  \"signatureCryptoSuite\": \"EcdsaSecp256r1Signature2019\",\r\n  \"metaDataDisplay\": [\r\n    {\r\n      \"logo\": {\r\n        \"uri\": \"https://example.com/logo.png\",\r\n        \"alt_text\": \"Driving License Logo\"\r\n      },\r\n      \"name\": \"DrivingLicenseCredential\",\r\n      \"locale\": \"en\",\r\n      \"text_color\": \"#FFFFFF\",\r\n      \"background_color\": \"#12107c\",\r\n      \"background_image\": {\r\n        \"uri\": \"https://inji.github.io/inji-config/logos/agro-vertias-logo.png\"\r\n      }\r\n    }\r\n  ],\r\n  \"displayOrder\": [\r\n    \"org.iso.18013.5.1~family_name\",\r\n    \"org.iso.18013.5.1~given_name\",\r\n    \"org.iso.18013.5.1~birth_date\",\r\n    \"org.iso.18013.5.1~document_number\"\r\n  ],\r\n  \"scope\": \"sample_vc_mdoc\",\r\n  \"qrSettings\": [\r\n    {\r\n      \"Full Name\": \"${fullName}\",\r\n      \"Phone Number\": \"${mobileNumber}\",\r\n      \"Date Of Birth\": \"${dateOfBirth}\"\r\n    }\r\n  ],\r\n  \"qrSignatureAlgo\": \"EdDSA\",\r\n  \"msoMdocClaims\": {\r\n    \"org.iso.18013.5.1\": {\r\n      \"document_number\": {\r\n        \"display\": [\r\n          {\r\n            \"name\": \"Document Number\",\r\n            \"locale\": \"en\"\r\n          }\r\n        ]\r\n      },\r\n      \"birth_date\": {\r\n        \"display\": [\r\n          {\r\n            \"name\": \"Date of Birth\",\r\n            \"locale\": \"en\"\r\n          }\r\n        ]\r\n      },\r\n      \"given_name\": {\r\n        \"display\": [\r\n          {\r\n            \"name\": \"Given Name\",\r\n            \"locale\": \"en\"\r\n          }\r\n        ]\r\n      },\r\n      \"family_name\": {\r\n        \"display\": [\r\n          {\r\n            \"name\": \"Family Name\",\r\n            \"locale\": \"en\"\r\n          }\r\n        ]\r\n      }\r\n    }\r\n  },\r\n  \"doctype\": \"org.iso.18013.5.1.mDL\"\r\n}",
							"options": {
